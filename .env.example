# Copy this file to `.env` and fill in your keys. `.env` is gitignored —
# never commit real keys. Register the free keys before running the
# collector that needs them. All sources below are free.

# BEA Regional (GDP by state/metro, personal income, price parities)
# Register (instant, emailed UserID): https://apps.bea.gov/API/signup/
BEA_API_KEY=

# BLS v2 (employment & wages: QCEW, CES, LAUS, OEWS)
# Register: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Census (population/PEP, ACS migration, BFS, CBP, govt finance)
# Register: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# EIA v2 (electricity prices, generation mix by state)
# Register: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# USPTO PatentsView Search API (patents by state)
# Request a key: https://patentsview.org/apis/keyrequest
PATENTSVIEW_API_KEY=

# SEC EDGAR needs NO key, but requires a descriptive User-Agent header.
# Format: "Your Name your-email@example.com"
SEC_USER_AGENT=

# Sources that need neither a key nor a UA (CSV downloads):
#   IRS SOI Migration, FHFA HPI, Zillow Research.
